# ---------------------------------------------------------------------------
# audit5s — environment contract
# Copy to .env for local development. Never commit a filled-in copy.
# Every variable consumed by apps/ or packages/ appears here; see infra/README.md
# for which secret store supplies each one in the single deployed environment.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API -------------------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0
# Comma-separated allow-list. No wildcard in the deployed environment.
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL 18) ----------------------------------------------
# The application role. It is deliberately NOT the owner: append-only tables
# withhold UPDATE/DELETE from it (AL-1) and RLS applies to it.
DATABASE_URL=postgres://audit5s_app:audit5s_app@localhost:5432/audit5s
# The migration/owner role. Used only by `pnpm db:migrate`, never by the API.
DATABASE_MIGRATION_URL=postgres://audit5s_owner:audit5s_owner@localhost:5432/audit5s
DATABASE_POOL_MAX=10

# --- JWT (RS256; asymmetric so workers verify without the signing key) ------
# PEM, base64-encoded to survive single-line env transport.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ISSUER=https://api.audit5s.example
JWT_AUDIENCE=audit5s
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Bootstrap credential lifetime (CH-1).
BOOTSTRAP_PASSWORD_TTL_HOURS=72

# --- Object storage (Cloudflare R2 via @aws-sdk/client-s3) ------------------
# Endpoint is an env var precisely so a dev MinIO stand-in needs no code change.
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_EVIDENCE=
R2_BUCKET_REPORTS=
R2_BUCKET_IMPORTS=
# Where the filesystem driver writes when R2_ENDPOINT is unset (development and CI only).
# A deployed environment sets R2_ENDPOINT and never reaches this.
OBJECT_STORAGE_LOCAL_DIR=.data/object-storage
# Where that driver's presigned URLs point (DECISIONS.md R-9). Absolute, because a device
# and a browser both resolve it without knowing how the API is mounted. Ignored under R2.
OBJECT_STORAGE_PUBLIC_URL=http://127.0.0.1:3000/api/v1
# Signs them. Unset means a fresh key per process, so a restart invalidates outstanding
# links — the right default for a driver that is not a production path. Set it only when a
# test run has to span a restart. Minimum 16 characters.
OBJECT_STORAGE_SIGNING_SECRET=

# --- Evidence URL lifetimes (§12.6) ----------------------------------------
# Both are capped in the port, above the driver, so neither can exceed the ceiling.
EVIDENCE_GET_URL_TTL_SECONDS=300
EVIDENCE_PUT_URL_TTL_SECONDS=900

# --- Device lock release (§9.5, D7) ----------------------------------------
# How long a PAUSED audit keeps its device lock before the sweep releases it, so a lost
# phone does not strand the work on it.
DEVICE_RELEASE_GRACE_HOURS=24

# --- Corrective actions (§5.7) ---------------------------------------------
# Days from an audit's completion to a corrective action's due date. A house default, not
# a business rule (DECISIONS.md R-13); 0 means the action carries no due date.
CORRECTIVE_ACTION_DUE_DAYS=7

# --- Reports (PART 10) ------------------------------------------------------
# Where a signed corrective-action link points. The PDF prints `{WEB_APP_URL}/ca/{token}`,
# so this value is baked into every report ever generated — changing it does not rewrite
# documents already issued, which is why it is one setting rather than a per-report option.
WEB_APP_URL=http://127.0.0.1:5173
# §10.4: a link's lifetime, fixed at minting. The remedy for a link that has run out is to
# mint another, not to extend it — a trigger enforces that.
REPORT_TOKEN_TTL_DAYS=30
# A report's presigned download. §12.6 caps it at 300 s regardless of what is set here.
REPORT_GET_URL_TTL_SECONDS=300
# STACK.md §5: "120s job timeout, one retry, then a visible dead-letter."
REPORT_RENDER_TIMEOUT_MS=120000
# Where `worker-report` finds its browser. The image bakes Alpine's Chromium in and sets
# this; unset means Playwright's own resolution, which is what a developer machine wants.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

# --- Checklist import (§12.8) ----------------------------------------------
# Hard cap on an uploaded workbook, and how long a preview stays committable.
CHECKLIST_IMPORT_MAX_BYTES=10485760
CHECKLIST_IMPORT_PREVIEW_TTL_HOURS=24

# --- Queue (pg-boss, same PostgreSQL — no Redis) ---------------------------
PGBOSS_SCHEMA=pgboss
PGBOSS_JOB_RETENTION_DAYS=7
# Which queues this process serves. Set per entrypoint by docker-compose.

# --- Seed (Q4: read from env, fail loudly if unset) ------------------------
SEED_SUPER_ADMIN_FULL_NAME=
SEED_SUPER_ADMIN_PHONE=
SEED_SUPER_ADMIN_EMAIL=

# --- Push (Q1: adapter logs to console until these are supplied) -----------
FCM_SERVICE_ACCOUNT_JSON_B64=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=

# --- Admin web (Vite; only VITE_* reaches the browser bundle) --------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
