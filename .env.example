# ---------------------------------------------------------------------------
# audit5s — environment contract
# Copy to .env for local development. Never commit a filled-in copy.
# Every variable consumed by apps/ or packages/ appears here; see infra/README.md
# for which secret store supplies each one in the single deployed environment.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API -------------------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0
# Comma-separated allow-list. No wildcard in the deployed environment.
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL 18) ----------------------------------------------
# The application role. It is deliberately NOT the owner: append-only tables
# withhold UPDATE/DELETE from it (AL-1) and RLS applies to it.
DATABASE_URL=postgres://audit5s_app:audit5s_app@localhost:5432/audit5s
# The migration/owner role. Used only by `pnpm db:migrate`, never by the API.
DATABASE_MIGRATION_URL=postgres://audit5s_owner:audit5s_owner@localhost:5432/audit5s
DATABASE_POOL_MAX=10

# --- JWT (RS256; asymmetric so workers verify without the signing key) ------
# PEM, base64-encoded to survive single-line env transport.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ISSUER=https://api.audit5s.example
JWT_AUDIENCE=audit5s
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Bootstrap credential lifetime (CH-1).
BOOTSTRAP_PASSWORD_TTL_HOURS=72

# --- Object storage (Cloudflare R2 via @aws-sdk/client-s3) ------------------
# Endpoint is an env var precisely so a dev MinIO stand-in needs no code change.
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_EVIDENCE=
R2_BUCKET_REPORTS=
R2_BUCKET_IMPORTS=
# Where the filesystem driver writes when R2_ENDPOINT is unset (development and CI only).
# A deployed environment sets R2_ENDPOINT and never reaches this.
OBJECT_STORAGE_LOCAL_DIR=.data/object-storage

# --- Checklist import (§12.8) ----------------------------------------------
# Hard cap on an uploaded workbook, and how long a preview stays committable.
CHECKLIST_IMPORT_MAX_BYTES=10485760
CHECKLIST_IMPORT_PREVIEW_TTL_HOURS=24

# --- Queue (pg-boss, same PostgreSQL — no Redis) ---------------------------
PGBOSS_SCHEMA=pgboss
PGBOSS_ARCHIVE_COMPLETED_AFTER_SECONDS=43200
PGBOSS_DELETE_ARCHIVED_AFTER_DAYS=7
# Which queues this process serves. Set per entrypoint by docker-compose.
WORKER_QUEUES=

# --- Seed (Q4: read from env, fail loudly if unset) ------------------------
SEED_SUPER_ADMIN_FULL_NAME=
SEED_SUPER_ADMIN_PHONE=
SEED_SUPER_ADMIN_EMAIL=

# --- Push (Q1: adapter logs to console until these are supplied) -----------
FCM_SERVICE_ACCOUNT_JSON_B64=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=

# --- Admin web (Vite; only VITE_* reaches the browser bundle) --------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
