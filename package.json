{
  "name": "audit5s",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @audit5s/db migrate",
    "seed": "pnpm --filter @audit5s/api seed",
    "dev:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "overrides": {
      "@react-native/metro-config": "0.86.3"
    }
  }
}
