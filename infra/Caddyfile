{
  email {$ACME_EMAIL}
}

{$APP_HOST} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://{$OBJECTS_HOST}; connect-src 'self' https://{$OBJECTS_HOST}; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
  }

  handle /api/* {
    reverse_proxy api:3000
  }

  # R-66: the APK is public, so a QR code opens it straight away.
  handle /downloads/* {
    root * /srv
    file_server
  }

  handle /.well-known/* {
    root * /srv
    file_server
  }

  # The field app in a browser, for phones without the APK (iOS). Its local database is
  # SQLite in WebAssembly on a SharedArrayBuffer, which needs the page cross-origin isolated
  # (COOP + COEP), wasm compilation, a blob: worker, and fetch of the data: URLs photos are
  # kept as until they upload.
  handle /field* {
    header {
      Cross-Origin-Opener-Policy "same-origin"
      Cross-Origin-Embedder-Policy "require-corp"
      Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://{$OBJECTS_HOST}; connect-src 'self' data: blob: https://{$OBJECTS_HOST}; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    }
    root * /srv
    try_files {path} /field/index.html
    file_server
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}

{$API_HOSTNAME} {
  reverse_proxy api:3000
}

{$OBJECTS_HOST} {
  # SigV4 includes the Host, path and query. Do not rewrite any of them.
  # CORP lets the cross-origin-isolated field web (/field) show these photos.
  header Cross-Origin-Resource-Policy "cross-origin"
  reverse_proxy object-storage:9000
}
