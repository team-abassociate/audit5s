{
  "name": "@audit5s/field-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "@types/react"
      ]
    }
  },
  "scripts": {
    "eas-build-post-install": "cd ../.. && pnpm --filter @audit5s/domain --filter @audit5s/contracts build",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "maestro test .maestro"
  },
  "dependencies": {
    "@audit5s/contracts": "workspace:*",
    "@audit5s/domain": "workspace:*",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@tanstack/react-query": "^5.64.1",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.22",
    "expo-build-properties": "~57.0.19",
    "expo-camera": "^57.0.5",
    "expo-constants": "~57.0.18",
    "expo-crypto": "^57.0.3",
    "expo-file-system": "^57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "^57.0.17",
    "expo-linking": "~57.0.10",
    "expo-location": "^57.0.17",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "zod": "^4.6.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}