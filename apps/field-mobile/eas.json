{
  "cli": {
    "version": ">= 24.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "API_BASE_URL": "http://192.168.68.185:3000/api/v1",
        "ALLOW_CLEARTEXT": "1"
      },
      "channel": "preview"
    },
    "vps": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_DEPLOYMENT": "production",
        "API_BASE_URL": "https://app.leanstack.tech/api/v1",
        "WEB_APP_HOST": "app.leanstack.tech"
      },
      "channel": "production"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
